{
  "name": "@readany/narra-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReadAny Narra gateway for provider routing, installation auth and analytics delivery",
  "main": "index.mjs",
  "scripts": {
    "start": "node index.mjs",
    "dev": "node --env-file=.env index.mjs",
    "worker:book-markup": "node books/book-markup-worker.mjs",
    "worker:book-identity": "node books/book-identity-worker.mjs",
    "worker:book-tts-markup": "node tts/book-tts-markup-worker-runner.mjs",
    "worker:book-analysis": "node analysis/book-analysis-worker.mjs",
    "worker:book-analysis-external": "node analysis/book-analysis-worker.mjs external",
    "worker:book-search": "node search/book-search-worker-runner.mjs",
    "book-analysis": "node analysis/book-analysis-operator.mjs",
    "report:generation-cost": "node generation/generation-cost-report.mjs",
    "book-search": "node search/book-search-operator.mjs",
    "evaluate:book-identity": "node analysis/book-analysis-identity-replay.mjs",
    "migrate:book-markup": "node books/migrate-book-markup.mjs",
    "backfill:book-markup": "node books/backfill-book-markup.mjs",
    "backfill:character-sections": "node books/backfill-character-section-anchors.mjs",
    "backfill:book-content-navigation": "node books/backfill-book-content-navigation.mjs",
    "seed:catalog": "node catalog/seed-book-catalog.mjs",
    "retry:book-generation": "node books/retry-failed-book-generation.mjs",
    "operator:generation-queue": "node generation/generation-queue-operator.mjs",
    "operator:character-correction": "node books/book-character-correction-operator.mjs",
    "migrate": "node db/migrate.mjs",
    "migrate:check": "node db/migrate.mjs --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fflate": "^0.8.2",
    "pg": "^8.23.0"
  }
}
