# Pipeline новых runs: narra или external. CLI --pipeline имеет приоритет.
BOOK_ANALYSIS_PIPELINE=narra

# Уникальное имя не позволяет research stack пересечься с другим local checkout.
NARRA_BOOK_ANALYSIS_PROJECT=narra-dual-pipeline-research

# Только для external pipeline.
AUTIOBOOK_LLM_BASE_URL=https://your-openai-compatible.example/v1
AUTIOBOOK_LLM_API_KEY=
AUTIOBOOK_LLM_MODEL=
AUTIOBOOK_ADAPTER_TOKEN=replace-with-at-least-32-random-characters
AUTIOBOOK_MAX_CONCURRENCY=1

# Выберите один route для narra. External использует endpoint выше.
BOOK_ANALYSIS_LLM_ROUTE=litellm
LITELLM_BASE_URL=https://your-litellm.example/v1
LITELLM_API_KEY=
LITELLM_MODEL=openrouter/openai/gpt-5.6-luna
LITELLM_OMIT_TEMPERATURE=true

# Альтернатива: внутренний Giga/OpenAI-compatible proxy.
# BOOK_ANALYSIS_LLM_ROUTE=giga
# LLM_BASE_URL=https://your-giga-proxy.example/v1
# LLM_API_KEY=
# LLM_MODEL=gigachat-3-ultra

# При необходимости можно задать fallback: giga или litellm.
BOOK_ANALYSIS_LLM_FALLBACK=

# Локальные порты. Все сервисы слушают только loopback.
NARRA_BOOK_ANALYSIS_PORT=18787
NARRA_BOOK_ANALYSIS_MINIO_PORT=19000
NARRA_BOOK_ANALYSIS_MINIO_CONSOLE_PORT=19001
