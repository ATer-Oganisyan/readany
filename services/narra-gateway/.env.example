# Narra gateway v2. Скопируй в .env только для локальной разработки.
# В Railway все значения задаются Variables; секреты не коммитятся.

PORT=8787
NODE_ENV=development

# PostgreSQL хранит каталог, версии разметки, очередь и атомарные media bundles.
DATABASE_URL=postgresql://readany:readany@localhost:5432/readany
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Worker обращается к внутренним маршрутам того же Gateway.
# Токен независим от пользовательских installation-токенов и содержит >= 32 символов.
GENERATOR_BASE_URL=http://localhost:8787
GENERATOR_SERVICE_TOKEN=
GENERATOR_TIMEOUT_MS=600000

# Pipeline для новых runs. Сохранённый run не перечитывает это значение.
# Значение narra снято вместе со старым конвейером и роняет процесс на старте.
BOOK_ANALYSIS_PIPELINE=cards
# Поимённый список изданий, которым назначен конвейер карточек (канарейка).
# Пустое значение — карточек нет ни у кого; опечатка в id роняет процесс на старте.
BOOK_ANALYSIS_CARDS_EDITIONS=
# false сохраняет полную разметку, но не создаёт jobs для портретов/audio/scenes/covers.
BOOK_ANALYSIS_MEDIA_GENERATION_ENABLED=true
# Что карточка персонажа заказывает себе из медиа. Пусто — портрет и
# приветственное аудио. idle_animation (оживший портрет в mp4) в набор не
# входит: это отдельный вызов видеогенерации на каждого персонажа, а продукт
# анимацию не показывает. Незнакомый тип роняет процесс на старте.
BOOK_CHARACTER_MEDIA=primary_portrait,greeting_audio
# Ставить портрет и приветствие сразу за публикацией карточки. На массовой
# разметке каталога выключается: медиа собирается по запросу читателя.
BOOK_CARD_MEDIA_ENQUEUE=true
# Делать ли сцены заранее. none — сцена появляется, когда читатель её открыл;
# это решение после инцидента 31 августа, когда очередь сцен (10 639 заданий
# по 148 книгам) чистили руками. reader — пачками за читателем: всё до его
# позиции плюс 10 % книги, у романа это 4–14 сцен за раз. book — вся книга
# сразу, прежнее поведение, которым инцидент и был вызван.
BOOK_SCENE_PREGENERATION=none
# Подогрев по области видимости книги. У каталожной фронтир равен всей книге —
# это и вызвало инцидент 31 августа. У приватной он равен позиции читателя плюс
# десятая часть книги, то есть 4–14 сцен за раз, и включать его ей безопасно
# там, где каталогу нельзя. Пусто — приватные живут по общей настройке.
BOOK_SCENE_PREGENERATION_PRIVATE=
# Optional comma-separated run UUID allowlist for isolated analysis workers.
BOOK_ANALYSIS_RUN_IDS=
# Стадии, которые опрашивает процесс: пусто или all — все канонические стадии.
# BOOK_ANALYSIS_STAGES=prepare,resolve
# Общие настройки цикла воркера анализа (прежние per-stage переменные удалены).
BOOK_ANALYSIS_POLL_MS=1000
BOOK_ANALYSIS_IDLE_LOG_MS=300000
BOOK_ANALYSIS_LEASE_SECONDS=300
BOOK_ANALYSIS_LEASE_RENEW_MS=60000
# ScanPolicy не меняет версию pipeline/extractor. balanced по умолчанию делает
# один полный запрос и один adaptive split; conservative оставляет до 5
# семантических попыток, fast принимает первый валидный пустой ответ.
BOOK_ANALYSIS_SCAN_POLICY_PROFILE=balanced
# Необязательные точечные overrides профиля:
# BOOK_ANALYSIS_SCAN_SEMANTIC_MAX_ATTEMPTS=1
# BOOK_ANALYSIS_SCAN_EMPTY_OBSERVATION_MODE=confirm_split
# BOOK_ANALYSIS_SCAN_ADAPTIVE_SPLIT_ENABLED=true
# BOOK_ANALYSIS_SCAN_ADAPTIVE_MIN_CORE_CHARS=2000
# BOOK_ANALYSIS_SCAN_ADAPTIVE_OVERLAP_CHARS=500
# Текущие размеры новых, ещё не подготовленных runs остаются прежними:
# BOOK_ANALYSIS_SCAN_CHUNK_TARGET_CHARS=4000
# BOOK_ANALYSIS_SCAN_CHUNK_MIN_CHARS=2500
# BOOK_ANALYSIS_SCAN_CHUNK_MAX_CHARS=5000
# BOOK_ANALYSIS_SCAN_CHUNK_OVERLAP_CHARS=500
# Поиск выключен по умолчанию. Он не ставит книги в очередь автоматически:
# только `npm run book-search -- enqueue <book-edition-uuid>`.
BOOK_SEARCH_ENABLED=false
BOOK_SEARCH_INDEX_VERSION=book-search-v1
BOOK_SEARCH_WORKER_ID=local-book-search-worker
# Content и narrative workers запускаются отдельными процессами/контейнерами.
BOOK_SEARCH_JOB_TYPES=lexical,embedding
# SQL claim жёстко разделяет каталожные и пользовательские книги.
BOOK_SEARCH_BOOK_SCOPES=catalog,private
BOOK_SEARCH_WORKER_CONCURRENCY=2
BOOK_SEARCH_POLL_MS=1000
BOOK_SEARCH_LEASE_SECONDS=300
BOOK_SEARCH_LEASE_RENEW_MS=60000
# OpenAI-compatible POST /v1/embeddings; если URL/ключ не заданы,
# локально используются LITELLM_BASE_URL/LITELLM_API_KEY.
BOOK_EMBEDDING_BASE_URL=
BOOK_EMBEDDING_API_KEY=
BOOK_EMBEDDING_PROVIDER=openai-compatible
BOOK_EMBEDDING_MODEL=text-embedding-3-large
BOOK_EMBEDDING_DIMENSIONS=1024
BOOK_EMBEDDING_TIMEOUT_MS=60000
# Явная цена входных токенов для metering; 0 означает «стоимость неизвестна».
BOOK_EMBEDDING_INPUT_USD_PER_MILLION=0
# Только для pipeline=external; adapter не публикует host ports.
AUTIOBOOK_ADAPTER_BASE_URL=http://localhost:8080
AUTIOBOOK_ADAPTER_TOKEN=
AUTIOBOOK_ADAPTER_TIMEOUT_MS=3600000
AUTIOBOOK_LLM_BASE_URL=
AUTIOBOOK_LLM_API_KEY=
AUTIOBOOK_LLM_MODEL=
AUTIOBOOK_MAX_CONCURRENCY=1

# Отдельный процесс npm run worker:book-markup.
BOOK_MARKUP_WORKER_ID=local-book-markup-worker
BOOK_MARKUP_WORKER_POLL_MS=1000
BOOK_MARKUP_IDLE_LOG_MS=300000
BOOK_MARKUP_JOB_LEASE_SECONDS=300
BOOK_MARKUP_LEASE_RENEW_MS=60000
BOOK_MARKUP_BACKFILL_BATCH_SIZE=100
BOOK_GENERATION_RETRY_BATCH_SIZE=100

# Отдельный однопоточный воркер отображаемых названий книг.
BOOK_IDENTITY_WORKER_ID=local-book-identity-worker
BOOK_IDENTITY_WORKER_POLL_MS=1000
BOOK_IDENTITY_JOB_LEASE_SECONDS=300
BOOK_IDENTITY_WORKER_REPLICAS=1

# Независимый sidecar-воркер разметки реплик для озвучки книг.
BOOK_TTS_MARKUP_WORKER_ID=local-book-tts-markup-worker
BOOK_TTS_MARKUP_WORKER_POLL_MS=1000
BOOK_TTS_MARKUP_JOB_LEASE_SECONDS=600
BOOK_TTS_MARKUP_LEASE_RENEW_MS=60000
BOOK_TTS_MARKUP_WORKER_REPLICAS=1
BOOK_MARKUP_WORKER_REPLICAS=1
BOOK_MEDIA_WORKER_REPLICAS=1
BOOK_SCENE_WORKER_REPLICAS=1
# Карточки персонажей и подтверждение состава (профиль cards).
# Параллельность карточек равна числу реплик: один процесс берёт одно задание.
# Внутри книги в работе одно окно, поэтому на N книг разом нужно хотя бы N реплик.
BOOK_CARD_WORKER_REPLICAS=6
# Один воркер обслуживает все шесть стадий канонического анализа.
BOOK_ANALYSIS_WORKER_REPLICAS=1
# Опциональный пул под горячие стадии (профиль book-analysis-pool).
BOOK_ANALYSIS_POOL_STAGES=prepare
BOOK_ANALYSIS_POOL_REPLICAS=2

# S3-compatible object storage for source books and generated media.
BOOK_STORAGE_BUCKET=
BOOK_STORAGE_REGION=us-east-1
BOOK_STORAGE_ENDPOINT=
BOOK_STORAGE_PUBLIC_ENDPOINT=
BOOK_STORAGE_ACCESS_KEY_ID=
BOOK_STORAGE_SECRET_ACCESS_KEY=
BOOK_STORAGE_FORCE_PATH_STYLE=false
BOOK_BACKEND_REQUIRED=false
BOOK_SHADOW_PREVIEW_ENABLED=false
BOOK_UPLOAD_MAX_MIB=50
BOOK_UPLOAD_URL_TTL_SECONDS=900
BOOK_DOWNLOAD_URL_TTL_SECONDS=300
# Производные данные пользовательских книг продлеваются при обращении и
# удаляются после периода неактивности вместе с объектами в S3/MinIO.
PRIVATE_MATERIAL_TTL_DAYS=7
PRIVATE_MATERIAL_CLEANUP_MS=3600000
PRIVATE_MATERIAL_CLEANUP_BATCH_SIZE=100

# Только для Compose на i167: MinIO root и отдельный ключ приложения.
# Эти значения хранятся в закрытом deployment .env, а не в /etc/narra-gateway.env.
NARRA_COMPOSE_PROJECT=narra
NARRA_HOST_PORT=8788
NARRA_ENV_FILE=/etc/narra-gateway.env
NARRA_GATEWAY_VOLUME=narra_gateway-data
NARRA_MINIO_ROOT_USER=narra-root
NARRA_MINIO_ROOT_PASSWORD=
NARRA_STORAGE_BUCKET=narra-books
NARRA_STORAGE_ACCESS_KEY_ID=narra-gateway
NARRA_STORAGE_SECRET_ACCESS_KEY=

# Обязательные production secrets: независимые случайные строки >= 32 символов.
GATEWAY_TOKEN_SECRET=
ANALYTICS_HMAC_SECRET=
INSTALLATION_SECRET_PEPPER=
INSTALLATION_OPERATOR_TOKEN=
# Независимый token для POST /v2/admin/catalog/* и seed:catalog.
CATALOG_INGEST_TOKEN=
# Защищённый браузерный интерфейс /operator/ (пароль >= 20 символов).
BOOK_OPERATOR_USERNAME=narra
BOOK_OPERATOR_PASSWORD=
DATA_DIR=./.data
ANALYTICS_ENV=development

# Доставка в самостоятельный stats-narra (оба значения задаются вместе).
TRACTION_INGEST_URL=
TRACTION_INGEST_TOKEN=

# Основной командный LiteLLM / Giga-compatible OpenAI API.
# В production нужен HTTPS или Railway private networking.
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=
LLM_MODEL=gigachat-3-ultra

# Независимый LiteLLM fallback для моделей другого upstream-провайдера.
# Модель указывается в точном формате, опубликованном этим LiteLLM proxy.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=openrouter/openai/gpt-5.6-luna
# Отдельная image-модель, опубликованная тем же LiteLLM proxy.
LITELLM_IMAGE_MODEL=openai/gpt-image-2
# Nano Banana 2 fallback остаётся внутри выбранного LiteLLM route.
LITELLM_IMAGE_FALLBACK_MODEL=openrouter/google/gemini-3.1-flash-image
# Public plaintext HTTP разрешается только явно и для точного allowlisted host.
ALLOW_INSECURE_LLM_HTTP=false
LLM_INSECURE_HTTP_HOSTS=

# Потолок ответа LLM (в токенах ответа, вход не ограничивает).
# Дефолты: 4096 для стрима, 8000 для complete; точечно per-purpose,
# например LLM_MAX_TOKENS_STRUCTURED_TASK=12000. Границы: 256..32000.
# Reasoning-модели (gpt-5.6-luna и родня) принимают только температуру по
# умолчанию и отвечают 400 на явное значение — тогда ставим true, и шлюз
# перестаёт передавать temperature наверх (клиент менять не нужно).
LLM_OMIT_TEMPERATURE=false
LITELLM_OMIT_TEMPERATURE=false
# Структурные задачи просят у модели response_format=json_object: без него
# reasoning-модель тратит весь max_tokens на рассуждение и отдаёт пустой ответ.
# true — только для провайдера, который отвечает на такой запрос 400.
LLM_OMIT_JSON_RESPONSE_FORMAT=false
LITELLM_OMIT_JSON_RESPONSE_FORMAT=false

LLM_MAX_TOKENS_STREAM=4096
LLM_MAX_TOKENS_COMPLETE=8000

# Backend-owned маршрут обложек: litellm использует LITELLM_* выше и стандартный
# POST /v1/images/generations; openrouter сохраняет прежний совместимый контракт.
COVER_IMAGE_PROVIDER=openrouter
COVER_IMAGE_TIMEOUT_MS=900000
# Качество GPT Image задаётся отдельно по назначению; low, medium или high.
COVER_IMAGE_QUALITY=high
CHARACTER_PORTRAIT_IMAGE_QUALITY=high
SCENE_IMAGE_QUALITY=high
# Новый маршрут только для портретов персонажей; выключен до явного включения.
# 5xx откладывает повтор задания, HTTP 400 переключает модель по списку.
CHARACTER_PORTRAIT_RETRY_FALLBACK_ENABLED=false
# Модели идут через выбранный COVER_IMAGE_PROVIDER в указанном порядке.
# Если переменная не задана, используется его старый одиночный fallback;
# пустая строка означает отсутствие fallback. Максимум 8 моделей.
# CHARACTER_PORTRAIT_FALLBACK_MODELS=openrouter/google/gemini-3.1-flash-image,another/image-model
# Прямой OpenRouter остаётся отдельным image-маршрутом: клиент не видит ключ.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Прямой OpenRouter route для всех типов обложек, если выбран этим provider.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_IMAGE_FALLBACK_MODEL=google/gemini-3.1-flash-image
# Один provider-вызов может ждать очередь модели; job переживает HTTP disconnect/restart.
# Legacy override; COVER_IMAGE_TIMEOUT_MS имеет приоритет.
OPENROUTER_IMAGE_TIMEOUT_MS=900000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Narra

# Текстовый маршрут по назначению. Допустимы только giga или litellm.
# Ни один текстовый запрос не ходит в OpenRouter напрямую.
LLM_ROUTE_DEFAULT=giga
LLM_ROUTE_CHARACTER_CHAT=giga
LLM_ROUTE_STRUCTURED_TASK=giga

# Подтверждение состава книги — единственная стадия, где решение это суждение,
# а не извлечение: слитые в одного люди обратно не разделяются. Поэтому у неё
# своя модель, а пока её не задали — та же, что у структурных задач.
#
# Замер на «Обломове» и «Герое нашего времени» со снятым запретом по
# со-упоминанию: deepseek-v4-flash и v4-pro при response_format теряют
# рассуждение и принимают все пары подряд (99 из 99, 56 кандидатов в одного
# человека вместе с Петербургом и Парижем), gemma скачет от прогона к прогону
# (0 и 7 ложных слияний на одних и тех же данных), gpt-5.6-sol дважды подряд
# не сделал ни одного ложного слияния при крупнейшей склейке в семь форм имени.
LITELLM_MODEL_ROSTER_CONFIRM=gpt-5.6-sol
LLM_MAX_TOKENS_ROSTER_CONFIRM=16000
LLM_ROUTE_SUMMARY=giga
LLM_ROUTE_SCENARIO=giga
LLM_ROUTE_MEMORY=giga
# Пустое значение = без fallback; типовая схема — litellm.
LLM_FALLBACK_DEFAULT=litellm

# SaluteSpeech: либо готовый Basic key, либо client id + secret.
SALUTESPEECH_AUTH_KEY=
SALUTESPEECH_CLIENT_ID=
SALUTESPEECH_CLIENT_SECRET=
SBER_SALUTE_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
SBER_SALUTE_SYNTH_URL=https://smartspeech.sber.ru/rest/v1/text:synthesize
SBER_SALUTE_RECOGNIZE_URL=https://smartspeech.sber.ru/rest/v1/speech:recognize

# Kandinsky image/video.
KANDINSKY_TOKEN=
VIDEO_BASE_URL=
# Временный video upstream Сони доступен только по HTTP. Включать строго
# осознанно и только до появления HTTPS: bearer token, изображения и аудио
# иначе идут по сети без шифрования.
ALLOW_INSECURE_VIDEO_HTTP=false
VIDEO_INSECURE_HTTP_HOSTS=87.242.117.37

# Проверка TLS включена по умолчанию. true допустим только для локальной диагностики.
ALLOW_INSECURE_TLS=false

# Browser dev preview; Electron main-process requests не требуют CORS wildcard.
CORS_ORIGINS=http://localhost:5173
REGISTRATION_LIMIT_PER_HOUR=10
REGISTRATION_GLOBAL_LIMIT_PER_HOUR=500
REGISTRATION_GLOBAL_LIMIT_PER_DAY=250
REFRESH_LIMIT_PER_HOUR=20
REFRESH_ATTEMPT_LIMIT_PER_HOUR=40
INSTALLATION_REGISTRY_MAX=10000
INSTALLATION_INACTIVE_RETENTION_DAYS=30
INSTALLATION_TOKEN_TTL_SECONDS=900
# Обязательно true только когда Railway service pinned to one replica.
INSTALLATION_SINGLE_REPLICA_ACK=false
# Railway: исключить одновременную запись двух deploy и дать SIGTERM drain.
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
API_LIMIT_PER_MINUTE=120
EVENT_LIMIT_PER_MINUTE=10
AI_LIMIT_PER_MINUTE=30
AI_LIMIT_PER_DAY=500
AI_GLOBAL_LIMIT_PER_DAY=25000
SPEECH_LIMIT_PER_MINUTE=60
SPEECH_LIMIT_PER_DAY=1000
SPEECH_GLOBAL_LIMIT_PER_DAY=50000
IMAGE_LIMIT_PER_DAY=100
IMAGE_GLOBAL_LIMIT_PER_DAY=5000
COVER_LIMIT_PER_DAY=60
COVER_GLOBAL_LIMIT_PER_DAY=3000
VIDEO_LIMIT_PER_HOUR=8
VIDEO_LIMIT_PER_DAY=20
VIDEO_GLOBAL_LIMIT_PER_DAY=500
KANDINSKY_QUEUE_LIMIT=6
VIDEO_QUEUE_LIMIT=4
LLM_CONCURRENCY=12
LLM_QUEUE_LIMIT=16
LLM_RESPONSE_MAX_MIB=8
SPEECH_CONCURRENCY=5
SPEECH_QUEUE_LIMIT=16
IMAGE_CONCURRENCY=4
IMAGE_QUEUE_LIMIT=12
COVER_CONCURRENCY=2
COVER_QUEUE_LIMIT=8
COVER_JOB_WORKER_ENABLED=true
COVER_JOB_MAX=1000
COVER_JOB_TTL_HOURS=24
COVER_JOB_MAX_RESULT_MIB=16
COVER_JOB_MAX_ATTEMPTS=3
# 32m > 15m primary + 15m Nano Banana + transport/persistence margin.
COVER_JOB_ATTEMPT_TIMEOUT_SECONDS=1920
SCENE_JOB_WORKER_ENABLED=true
SCENE_JOB_MAX=1000
SCENE_JOB_TTL_HOURS=24
SCENE_JOB_MAX_ATTEMPTS=3
SCENE_JOB_ATTEMPT_TIMEOUT_SECONDS=900
IMPORT_LIMIT_PER_MINUTE=6
IMPORT_LIMIT_PER_DAY=20
IMPORT_GLOBAL_LIMIT_PER_DAY=1000
IMPORT_LIMIT_MIB_PER_DAY=300
IMPORT_GLOBAL_LIMIT_MIB_PER_DAY=10000
IMPORT_CONCURRENCY=2
IMPORT_QUEUE_LIMIT=2
