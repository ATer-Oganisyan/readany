# EAS Build Ignore File
# Exclude large unused modules to reduce APK size

.git
.gitignore
.easignore

# Local dependency and native build artifacts. EAS installs dependencies and
# regenerates native projects in the cloud from app.config.js.
node_modules/
/ios/
/android/
dist/
.expo/

# Documentation
*.md
LICENSE
CHANGELOG

# Development tools
.vscode
.idea
.husky
.prettierrc
.eslintrc
.editorconfig
tsconfig.tsbuildinfo
metro.cache

# Ship only the selected production character loops. Local generation
# experiments in this directory add roughly 900 MB to the upload otherwise.
assets/catalog/character-video-samples/*
!assets/catalog/character-video-samples/*-grok-eyebrow-hair-only-batch5.json
!assets/catalog/character-video-samples/*-grok-eyebrow-hair-only-batch5-boomerang.mp4

# Test files
__tests__
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Large unused modules in monorepo
node_modules/onnxruntime-node
node_modules/onnxruntime-web
node_modules/@pagefind
node_modules/pdfjs-dist
node_modules/mermaid
node_modules/lucide-react
node_modules/react-devtools-core
node_modules/typescript
node_modules/esbuild
node_modules/@biomejs
