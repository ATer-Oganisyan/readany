+- (void)buildMenuWithBuilder:(id<UIMenuBuilder>)builder API_AVAILABLE(ios(13.0)) {
+  [super buildMenuWithBuilder:builder];
+  if (@available(iOS 16.0, *)) {
+    // Extend WebKit's selection menu so handle drags keep the same actions.
+    if (self.menuItems.count == 0) return;
+    NSMutableArray<UIMenuElement *> *commands = [NSMutableArray new];
+    for (NSDictionary *item in self.menuItems) {
+      NSString *selector = [CUSTOM_SELECTOR stringByAppendingString:item[@"key"]];
+      [commands addObject:[UICommand commandWithTitle:item[@"label"] image:nil
+        action:NSSelectorFromString(selector) propertyList:nil]];
+    }
+    [builder insertChildMenu:[UIMenu menuWithTitle:@"" image:nil
+      identifier:@"com.readany.selection" options:UIMenuOptionsDisplayInline children:commands]
+      atStartOfMenuForIdentifier:UIMenuRoot];
+  }
 }
