---
import sansRegularUrl from "../../../packages/deslop-primitives/fonts/SBSansUI-Regular.otf?url";
import sansSemiboldUrl from "../../../packages/deslop-primitives/fonts/SBSansUI-Semibold.otf?url";
import serifUrl from "../../../packages/deslop-primitives/fonts/SBSerifCondensed.otf?url";
import metaphorExplanations from "../data/cover-comparison-metaphors.json";

const manifestModules = import.meta.glob("../../public/cover-assets/manifest.json", {
  eager: true,
  import: "default",
});
const manifest = Object.values(manifestModules)[0] as
  | {
      generatedAt: string;
      providers: Array<{ id: string; label: string; model: string }>;
      books: Array<{
        id: string;
        title: string;
        author: string;
        outputs: Record<string, { status: string; path?: string; error?: string }>;
      }>;
    }
  | undefined;
const providers = manifest?.providers ?? [];
const books = manifest?.books ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const readyCount = books.reduce(
  (count, book) =>
    count + providers.filter((provider) => book.outputs[provider.id]?.status === "ready").length,
  0,
);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Сравнение обложек Nano Banana и GPT Image 2" />
    <title>Сравнение обложек</title>
    <style
      is:inline
      set:html={`
        @font-face { font-family: "SB Sans"; src: url("${sansRegularUrl}"); font-weight: 400; }
        @font-face { font-family: "SB Sans"; src: url("${sansSemiboldUrl}"); font-weight: 600; }
        @font-face { font-family: "SB Serif Condensed"; src: url("${serifUrl}"); font-weight: 400; }
      `}
    />
  </head>
  <body>
    <header class="page-header">
      <div>
        <h1>Сравнение обложек</h1>
        <p>Один промпт, две модели</p>
      </div>
      <p class="status">{readyCount} из {books.length * providers.length} изображений</p>
    </header>

    <main>
      {
        books.map((book, index) => (
          <article class="book">
            <header class="book__header">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h2>{book.title}</h2>
                <p>{book.author}</p>
              </div>
            </header>

            <div class="covers">
              {providers.map((provider) => {
                const output = book.outputs[provider.id];
                return (
                  <figure>
                    <figcaption>{provider.label}</figcaption>
                    {output?.status === "ready" && output.path ? (
                      <button
                        class="cover"
                        type="button"
                        data-fullscreen
                        aria-label={`Открыть обложку «${book.title}», ${provider.label}`}
                      >
                        <img
                          src={`${base}${output.path}`}
                          alt={`Обложка «${book.title}», ${provider.label}`}
                          loading={index < 2 ? "eager" : "lazy"}
                        />
                      </button>
                    ) : (
                      <div class="placeholder">Изображение не создано</div>
                    )}
                  </figure>
                );
              })}
            </div>

            <section class="metaphor" aria-label="Объяснение метафоры">
              <h3>Что означает метафора</h3>
              <p>
                {metaphorExplanations[book.id as keyof typeof metaphorExplanations] ??
                  "Метафора передаёт центральный конфликт книги через отношения формы, масштаба и пространства."}
              </p>
            </section>
          </article>
        ))
      }
    </main>

    <dialog data-lightbox>
      <button class="close" type="button" aria-label="Закрыть">Закрыть</button>
      <img alt="Увеличенная обложка" />
    </dialog>

    <script>
      const lightbox = document.querySelector("[data-lightbox]");
      for (const button of document.querySelectorAll("[data-fullscreen]")) {
        button.addEventListener("click", () => {
          const source = button.querySelector("img");
          const target = lightbox?.querySelector("img");
          if (!source || !target || !lightbox) return;
          target.src = source.src;
          target.alt = source.alt;
          lightbox.showModal();
        });
      }
      lightbox?.querySelector(".close")?.addEventListener("click", () => lightbox.close());
      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) lightbox.close();
      });
    </script>
  </body>
</html>

<style>
  :root {
    --paper: #f2f0e9;
    --ink: #111111;
    --muted: #686761;
    --line: #c8c5bc;
    font-family: "SB Sans", sans-serif;
    color: var(--ink);
    background: var(--paper);
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); }
  button { color: inherit; font: inherit; }
  button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .page-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding: 32px;
    border-bottom: 1px solid var(--ink);
  }

  .page-header h1 {
    margin: 0 0 6px;
    font-family: "SB Serif Condensed", serif;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 400;
    line-height: 0.95;
  }

  .page-header p { margin: 0; color: var(--muted); }
  .status { font-size: 13px; white-space: nowrap; }

  .book {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1.58fr);
    border-bottom: 1px solid var(--ink);
  }

  .book__header {
    padding: 32px;
    border-right: 1px solid var(--ink);
  }

  .book__header > span {
    display: block;
    margin-bottom: 64px;
    font-size: 11px;
    color: var(--muted);
  }

  .book h2 {
    max-width: 8em;
    margin: 0 0 8px;
    font-family: "SB Serif Condensed", serif;
    font-size: clamp(36px, 4vw, 60px);
    font-weight: 400;
    line-height: 0.92;
  }

  .book__header p { margin: 0; color: var(--muted); }

  .covers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  figure { min-width: 0; margin: 0; padding: 24px; }
  figure + figure { border-left: 1px solid var(--ink); }
  figcaption { height: 32px; font-size: 13px; font-weight: 600; }

  .cover {
    width: 100%;
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .cover img {
    width: 100%;
    aspect-ratio: 2 / 3;
    display: block;
    object-fit: cover;
  }

  .placeholder {
    aspect-ratio: 2 / 3;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .metaphor {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(130px, 0.35fr) minmax(0, 1.65fr);
    gap: 24px;
    padding: 24px;
    border-top: 1px solid var(--line);
  }

  .metaphor h3, .metaphor p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  .metaphor h3 { font-weight: 600; }
  .metaphor p { max-width: 68ch; }

  dialog {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    padding: 24px;
    border: 0;
    background: rgba(17, 17, 17, 0.96);
  }

  dialog::backdrop { background: rgba(17, 17, 17, 0.7); }
  dialog[open] { display: grid; place-items: center; }
  dialog img { max-width: min(78vw, 720px); max-height: 90vh; object-fit: contain; }
  .close { position: fixed; top: 24px; right: 24px; border: 0; color: white; background: transparent; cursor: pointer; }

  @media (max-width: 720px) {
    .page-header { padding: 20px 16px; }
    .status { display: none; }
    .book { display: block; }
    .book__header { padding: 24px 16px; border-right: 0; border-bottom: 1px solid var(--ink); }
    .book__header > span { margin-bottom: 32px; }
    .covers { overflow-x: auto; grid-template-columns: repeat(2, minmax(220px, 1fr)); }
    figure { padding: 12px; }
    figcaption { height: 42px; }
    .metaphor { grid-template-columns: 1fr; gap: 8px; padding: 20px 16px; }
  }
</style>
